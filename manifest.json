{
  "schema_version": 1,
  "target": {"os": "linux", "format": "ELF", "architecture": "x86-64"},
  "compilers": ["gcc", "clang"],
  "languages": ["c", "c++"],
  "optimizations": ["O0", "O1", "O2", "O3", "Os"],
  "pie_modes": ["pie", "non-pie"],
  "symbol_modes": ["symbols", "stripped"],
  "link_modes": ["dynamic", "static"],
  "sources": [
    {"name": "control_flow.c", "language": "c", "features": ["switch", "loops", "recursion", "pointers", "tls"]},
    {"name": "exceptions.cpp", "language": "c++", "features": ["recursion", "pointers", "exceptions"]},
    {"name": "vector_abi.c", "language": "c", "features": ["128-bit SIMD", "indirect calls", "variadic ABI"]},
    {"name": "indirect_calls.c", "language": "c", "features": ["function-pointer calls", "loops", "pointers"]},
    {"name": "indexed_memory.c", "language": "c", "features": ["indexed memory", "pointers"]},
    {"name": "stack_abi.c", "language": "c", "features": ["stack-passed arguments", "integer ABI"]},
    {"name": "variadic_tls.c", "language": "c", "features": ["floating-point varargs", "tls"]},
    {"name": "variadic_gp.c", "language": "c", "features": ["integer varargs", "register and stack ABI"]},
    {"name": "variadic_fp.c", "language": "c", "features": ["floating-point varargs", "XMM register and stack ABI"]},
    {"name": "threads_signals.c", "language": "c", "features": ["threads", "tls", "signals"]},
    {"name": "atomic_rmw.c", "language": "c", "features": ["threads", "locked memory read-modify-write", "locked exchange-add", "atomic flags"]},
    {"name": "avx128.c", "language": "c", "features": ["128-bit AVX", "packed floating point"]},
    {"name": "avx128_scalar.c", "language": "c", "features": ["scalar AVX", "vector call ABI"]},
    {"name": "avx128_integer.c", "language": "c", "features": ["128-bit integer SIMD"]},
    {"name": "avx128_compare.c", "language": "c", "features": ["VPCMPEQB", "VPCMPEQW", "VPCMPEQQ", "VPCMPGTB", "VPCMPGTW", "VPCMPGTQ", "128-bit integer comparisons"]},
    {"name": "avx_variable_shift.c", "language": "c", "features": ["VPSLLVD", "per-lane variable shifts", "128-bit and 256-bit integer SIMD"]},
    {"name": "avx_movmskb.c", "language": "c", "features": ["PMOVMSKB", "VPMOVMSKB", "XMM and YMM byte-mask extraction"]},
    {"name": "avx256_integer.c", "language": "c", "features": ["256-bit integer SIMD", "variable shifts"]},
    {"name": "avx256.c", "language": "c", "features": ["256-bit AVX", "packed floating point"]},
    {"name": "avx256_call.c", "language": "c", "features": ["256-bit vector call ABI"]},
    {"name": "avx256_vzeroupper.c", "language": "c", "features": ["VZEROUPPER", "256-bit SIMD state"]},
    {"name": "avx256_vzeroall.c", "language": "c", "features": ["VZEROALL", "256-bit SIMD state"]},
    {"name": "avx256_shuffle.c", "language": "c", "features": ["VPSHUFD", "256-bit integer SIMD"]},
    {"name": "avx256_byte_shuffle.c", "language": "c", "features": ["VPSHUFB", "128-bit and 256-bit integer SIMD"]},
    {"name": "avx256_permute.c", "language": "c", "features": ["VPERM2F128", "256-bit floating-point lane permutation"]},
    {"name": "avx256_lane_shuffle.c", "language": "c", "features": ["VPERMILPS", "256-bit floating-point lane shuffle"]},
    {"name": "avx256_lane_shuffle_pd.c", "language": "c", "features": ["VPERMILPD", "256-bit double-precision lane shuffle"]},
    {"name": "avx256_two_source_shuffle.c", "language": "c", "features": ["VSHUFPS", "VSHUFPD", "256-bit two-source floating-point shuffle"]},
    {"name": "avx256_two_source_blend.c", "language": "c", "features": ["VBLENDPS", "VBLENDPD", "256-bit two-source floating-point blend"]},
    {"name": "avx256_variable_blend.c", "language": "c", "features": ["VBLENDVPS", "VBLENDVPD", "256-bit vector-mask floating-point blend"]},
    {"name": "avx256_variable_permute.c", "language": "c", "features": ["VPERMILPS", "VPERMILPD", "256-bit vector-control floating-point permutation"]},
    {"name": "avx256_addsub.c", "language": "c", "features": ["VADDSUBPS", "VADDSUBPD", "256-bit alternating floating-point add-subtract"]},
    {"name": "avx256_compare.c", "language": "c", "features": ["VPCMPEQB", "VPCMPGTW", "VPCMPGTQ", "256-bit integer comparisons"]},
    {"name": "avx256_mixed_state.c", "language": "c", "features": ["VEX.128 to VEX.256 state transition", "256-bit SIMD state"]}
  ]
}
